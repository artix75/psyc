.TH PSVocabularyGetTokenByID 3 2024-03-09 "PsyC 0.9.5" "PsyC Library Functions Manual"

.SH NAME
\fBPSVocabularyGetTokenByID\fR \- Get the token by ID from vocabulary

.SH LIBRARY
PsyC (-lpsyc)

.SH SYNOPSIS

.B
#include <psyc/dataset.h>

.I
const char  *
.br
\fBPSVocabularyGetTokenByID\fR(\fIPSVocabulary *vocabulary\fR, \fIlong id\fR)
.SH DESCRIPTION
Get the token associated with \fIid\fR from \fIvocabulary\fR.  

.SH RETURN VALUES
The token associated with \fIid\fR or \fINULL\fR if no \fItoken\fR is found with \fIid\fR. Also return \fINULL\fR if \fIvocabulary\fR is \fINULL\fR.

.SH SEE ALSO
psyc(1)
